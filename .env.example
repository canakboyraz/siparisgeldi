# --- Flask ---
SECRET_KEY=degistir-uzun-rastgele-bir-deger

# --- Admin paneli ---
# Bu e-postalarla giriş yapan kullanıcılar /admin panelini görebilir (virgülle ayır)
ADMIN_EMAILS=

# --- Veritabanı ---
# Geliştirme: boş bırak → SQLite (siparis_saas.db)
# Prod: postgresql://kullanici:sifre@host:5432/veritabani
DATABASE_URL=

# --- API credential şifreleme (ZORUNLU) ---
# Üret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Merkezi Telegram botu ---
# BotFather'dan oluştur (/newbot). Token ve bot kullanıcı adını (@ olmadan) gir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Migros Yemek (Gourmet) ---
# Test: https://test-gourmet.migrosone.com | Canlı: https://gourmet.migrosonline.com
MIGROS_API_BASE=https://gourmet.migrosonline.com
# Secret Key = entegrasyon firması bazında TEK adet (şifreleme). Migros'a webhook
# URL'lerini ilettikten sonra sana verilir. Şimdilik boş bırakabilirsin.
MIGROS_SECRET_KEY=
# Migros webhook'ları Basic Auth ile gelir (firma bazında tek kimlik).
# Migros'a vereceğin kullanıcı/parola. Boşsa doğrulama atlanır.
MIGROS_WEBHOOK_USER=
MIGROS_WEBHOOK_PASS=
#
# Migros'a İLETİLECEK webhook URL'leri (uygulaman yayında olunca):
#   https://<alan-adin>/webhooks/migros/order-created
#   https://<alan-adin>/webhooks/migros/order-canceled
#   https://<alan-adin>/webhooks/migros/delivery-status

# --- WhatsApp (Meta Cloud API) ---
# Meta Business / developers.facebook.com'dan alınır. Kalıcı token için System User kullan.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Meta onaylı utility şablonu (proaktif bildirim için zorunlu)
WHATSAPP_TEMPLATE_NAME=siparis_bildirim
WHATSAPP_TEMPLATE_LANG=tr
# Günlük/haftalık/aylık rapor için AYRI Meta onaylı şablon (3 değişken)
WHATSAPP_REPORT_TEMPLATE_NAME=gunluk_raporr
WHATSAPP_SUBSCRIPTION_TEMPLATE_NAME=abonelik_uyarisi
WHATSAPP_SUBSCRIPTION_TEMPLATE_LANG=tr

# --- Ayarlar ---
POLL_INTERVAL_SECONDS=30
# TrendyolGo siparişi bu süre içinde kabul edilmezse ekstra uyarı gönderilir.
TGO_UNACCEPTED_ALERT_SECONDS=120
# Dev'de 1 (web süreci scheduler'ı çalıştırır). Prod'da 0 yapıp worker.py'yi ayrı çalıştır.
RUN_SCHEDULER=1

# --- E-posta (SMTP) — şifre sıfırlama + e-posta doğrulama ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adres@gmail.com,
#        SMTP_PASSWORD=<Google hesabı > Güvenlik > Uygulama şifreleri>
# Brevo/Resend/Yandex gibi servislerin SMTP bilgileri de aynı şekilde girilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiparişGeldi <destek@siparisgeldi.net>
# 465 portu kullanılıyorsa 1
SMTP_USE_SSL=0

# --- Deneme ve plan limitleri ---
# Yeni kayıtlara verilen Pro deneme günü (0 = kapalı)
TRIAL_DAYS=14
# Pro/deneme bitince "1 aktif platform" limiti: trial (sadece deneme bitenler) | all | off
PLAN_LIMIT_SCOPE=trial

# --- İzleme ---
# sentry.io projesinin DSN'i (boşsa Sentry kapalı)
SENTRY_DSN=
# Yönetici alarmları için Telegram chat id'leri (virgülle). Boşsa ADMIN_EMAILS
# kullanıcılarının panelden bağladığı Telegram'a gider.
ADMIN_ALERT_TELEGRAM_CHAT_IDS=
# Polling yapılan entegrasyon bu kadar dakika senkron olmazsa alarm
SYNC_STALE_ALERT_MINUTES=10
# Aynı anda işlenecek entegrasyon sayısı (Postgres'te; SQLite'ta hep 1)
POLL_MAX_WORKERS=8
LOG_LEVEL=INFO
